# Copy to .env on the deployment server. Never commit real secrets.
APP_PORT=8080
MYSQL_DATABASE=bd_analytics
MYSQL_USER=bd_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
# URL-encode special characters in username/password in DATABASE_URL.
DATABASE_URL=mysql+pymysql://bd_app:replace-with-a-long-random-password@db:3306/bd_analytics?charset=utf8mb4
ADMIN_PASSWORD=replace-with-a-unique-admin-password
# false for the provided LAN HTTP example; set true behind HTTPS.
COOKIE_SECURE=false
BD_ALLOWED_SOURCE_HOSTS=
# JSON values; provide actual read-only credentials only on your server.
BD_SOURCE_ORDER_MYSQL={}
BD_SOURCE_MAXCOMPUTE={}
